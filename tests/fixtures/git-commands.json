{
  "bringing": [
    "git merge --squash x",
    "git -C app pull",
    "git -C \"my dir\" pull",
    "cd app && git cherry-pick -n abc",
    "sh -c 'git merge x'",
    "/usr/bin/git checkout main",
    "git -c core.x=1 rebase main",
    "git --git-dir=.git pull",
    "bash -lc \"git merge --squash x && git commit -m y\"",
    "(git merge --squash x && git commit -m y)",
    "echo $(git merge x)",
    "echo `git merge x`",
    "FOO=1 git pull",
    "sudo git pull",
    "env GIT_X=1 git merge x",
    "git commit -m x || git merge y",
    "cd x; git pull",
    "sh -c \"sh -c 'git pull'\"",
    "gh pr checkout 12",
    "gh pr merge 12",
    "git submodule update --init",
    "git stash pop",
    "if git merge --squash x; then git commit -m y; fi",
    "git commit -m y && if true; then git merge --squash x; fi",
    "for b in a b; do git merge --squash $b; done",
    "{ git merge --squash x; git commit -m y; }",
    "! git merge --squash x",
    "while true; do git merge x; done",
    "until git merge x; do break; done"
  ],
  "commits": [
    "git commit -qam break",
    "git commit -m \"merge fix\"",
    "git commit -qam \"Fix git pull handling\"",
    "git commit -m \"fix git checkout bug\"",
    "git commit -m \"revert git merge change\"",
    "git commit -m 'a && git merge b'",
    "git commit -m \"a; git pull\"",
    "git log | grep merge",
    "echo git pull",
    "echo merge && git status",
    "make test",
    "",
    "git status",
    "git add -A && git commit -m x",
    "while read l; do git commit -am x; done"
  ],
  "unseen": [
    "echo \"$(git merge x)\"",
    "./merge.sh",
    "git ff",
    "patch -p1 < fix.diff && git commit -am x"
  ]
