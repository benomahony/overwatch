{
  "name": "overwatch",
  "version": "0.4.3",
  "description": "Runs project checks beside coding agents and feeds failures back into their turns.",
  "type": "module",
  "displayName": "overwatch",
  "publisher": "benomahony",
  "license": "MIT",
  "repository": "https://github.com/benomahony/overwatch",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./integrations/vscode.js",
  "exports": "./integrations/opencode.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      { "command": "overwatch.start", "title": "Overwatch: Start" },
      { "command": "overwatch.stop", "title": "Overwatch: Stop" },
      { "command": "overwatch.show", "title": "Overwatch: Show Report" },
      { "command": "overwatch.doctor", "title": "Overwatch: Doctor" }
    ]
  },
  "files": [
    "hooks/codex.py",
    "hooks/gating.py",
    "hooks/triage.py",
    "integrations",
    "watchers.json"
  ],
  "keywords": [
    "opencode-plugin",
    "vscode-extension",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./integrations/pi.js"
    ]
  }
}
