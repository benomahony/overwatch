{
  "search": {
    "depth": 2,
    "skip": ["node_modules", "target", "vendor", "dist", "build", "venv", "__pycache__", "zig-cache", "zig-out", "Downloads", "Desktop", "tmp", "temp", "scratch"]
  },
  "environment": [
    "Failed to (?:fetch|download):? `",
    "error sending request for url",
    "dns error|failed to lookup address information|nodename nor servname provided|Temporary failure in name resolution|Name or service not known",
    "\\bno wheels? (?:with a matching|for|available for)\\b",
    "`\\.python-version`|No interpreter found for Python|is incompatible with the project's Python requirement",
    "KeyError: '[A-Z0-9_]*(?:API_KEY|TOKEN|SECRET)[A-Z0-9_]*'|api_key client option must be set|[A-Z][A-Z0-9_]*_API_KEY environment variable|[Mm]issing (?:an? )?API key|API key (?:is )?(?:not set|not found|missing|required)"
  ],
  "watchers": [
    {
      "name": "zig",
      "marker": "build.zig",
      "argv": ["zig", "build", "-Doptimize=fast", "test", "--watch"],
      "summary": "^Build Summary:.*$",
      "failed": "failed",
      "failure": "^(?:error: '(.+)' failed:|(\\S+\\.zig:\\d+:\\d+: error: .+))$"
    },
    {
      "name": "python",
      "marker": "pyproject.toml",
      "requires": "uv",
      "argv": ["uv", "run", "--with", "pytest", "--with", "pytest-watcher", "--with", "pytest-testmon", "ptw", ".", "--testmon"],
      "baseline": ["uv", "run", "--with", "pytest", "--with", "pytest-testmon", "pytest", "--testmon-noselect"],
      "summary": "^=+ .+ in \\d+(?:\\.\\d+)?s(?: \\([^)]*\\))? =+$",
      "failed": "\\b(?:failed|errors?)\\b",
      "failure": "^(?:FAILED|ERROR) (\\S+)"
    },
    {
      "name": "python",
      "marker": "pyproject.toml",
      "requires": "pytest",
      "baseline": ["pytest"],
      "summary": "^=+ .+ in \\d+(?:\\.\\d+)?s(?: \\([^)]*\\))? =+$",
      "failed": "\\b(?:failed|errors?)\\b",
      "failure": "^(?:FAILED|ERROR) (\\S+)"
    },
    {
      "name": "vitest",
      "language": "js",
      "marker": "node_modules/.bin/vitest",
      "argv": ["npx", "--no", "--", "vitest", "watch"],
      "summary": "^ +Test Files +.*$",
      "failed": "\\bfailed\\b",
      "failure": "^ FAIL {2}(\\S+\\.\\w+(?: .*)?)$"
    },
    {
      "name": "jest",
      "language": "js",
      "marker": "node_modules/.bin/jest",
      "argv": ["npx", "--no", "--", "jest", "--watchAll"],
      "summary": "^Test Suites: .*total$",
      "failed": "\\bfailed\\b",
      "failure": "^(?:FAIL (\\S+)| {2}● (.+))$"
    },
    {
      "name": "bun",
      "language": "js",
      "marker": "bun.lock",
      "argv": ["bun", "test", "--watch"],
      "summary": "^ \\d+ fail$",
      "failed": "^[1-9]\\d* fail$",
      "failure": "^\\(fail\\) (.+?)(?: \\[[0-9.]+m?s\\])?$"
    },
    {
      "name": "bun",
      "language": "js",
      "marker": "bun.lockb",
      "argv": ["bun", "test", "--watch"],
      "summary": "^ \\d+ fail$",
      "failed": "^[1-9]\\d* fail$",
      "failure": "^\\(fail\\) (.+?)(?: \\[[0-9.]+m?s\\])?$"
    },
    {
      "name": "deno",
      "marker": "deno.json",
      "argv": ["deno", "test", "--watch"],
      "summary": "^Watcher \\w+ (?:finished|failed)\\..*$",
      "failed": "failed",
      "result": "^(?:ok|FAILED) \\| .*$",
      "failure": "^(\\S.* => \\S+:\\d+:\\d+)$"
    },
    {
      "name": "deno",
      "marker": "deno.jsonc",
      "argv": ["deno", "test", "--watch"],
      "summary": "^Watcher \\w+ (?:finished|failed)\\..*$",
      "failed": "failed",
      "result": "^(?:ok|FAILED) \\| .*$",
      "failure": "^(\\S.* => \\S+:\\d+:\\d+)$"
    },
    {
      "name": "go",
      "marker": "go.mod",
      "requires": "gotestsum",
      "argv": ["gotestsum", "--watch"],
      "baseline": ["gotestsum", "--", "./..."],
      "summary": "^DONE \\d+ tests?.*$",
      "failed": "\\b(?:failures?|errors?)\\b",
      "failure": "^(?:\\s*--- FAIL: (\\S+).*|=== FAIL: (.+?)(?: \\([0-9.]+s\\))?|(\\S+\\.go:\\d+:\\d+: .+))$"
    },
    {
      "name": "go",
      "marker": "go.mod",
      "baseline": ["go", "test", "./..."],
      "failure": "^(?:\\s*--- FAIL: (\\S+).*|=== FAIL: (.+?)(?: \\([0-9.]+s\\))?|(\\S+\\.go:\\d+:\\d+: .+))$"
    },
    {
      "name": "rust",
      "marker": "Cargo.toml",
      "baseline": ["cargo", "test"],
      "failure": "^(?:test (\\S+) \\.\\.\\. FAILED|(error\\[E\\d+\\]: .+))$"
    },
    {
      "name": "swift",
      "marker": "Package.swift",
      "baseline": ["swift", "test"],
      "failure": "^(?:\\S+ Test (\\S+\\)|\".+\") failed after .*|Test Case '(.+)' failed \\(.*|(\\S+\\.swift:\\d+(?::\\d+: error|: (?:Fatal error|Precondition failed|Assertion failed)): .+))$"
    }
  ],
  "checkers": [
    {
      "name": "zanity",
      "marker": "zanity",
      "argv": ["zanity", "check", ".", "--watch", "--no-color"],
      "summary": "^zanity: (?:\\d+ errors?(?:,| and) \\d+ warnings? in .*|checked .*, no issues found\\.?)$",
      "failed": "\\b[1-9]\\d* (?:errors?|warnings?)\\b"
    }
  ]
}
